<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Release Info.plist. It deliberately carries no NSAppTransportSecurity exception:
  Release builds must reach the API over HTTPS. The Debug counterpart is
  Info-Debug.plist, which is selected by the Debug configuration's INFOPLIST_FILE.
  Keep the two files in step when adding a key.
-->
<plist version="1.0">
<dict>
    <key>APIBaseURL</key>
    <string>$(API_BASE_URL)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleDisplayName</key>
    <string>Birdie Buddy</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>UIAppFonts</key>
    <array>
        <string>Fonts/outfit-400.ttf</string>
        <string>Fonts/outfit-500.ttf</string>
        <string>Fonts/outfit-600.ttf</string>
        <string>Fonts/outfit-700.ttf</string>
        <string>Fonts/space-grotesk-500.ttf</string>
        <string>Fonts/space-grotesk-600.ttf</string>
        <string>Fonts/space-grotesk-700.ttf</string>
        <string>Fonts/dm-mono-400.ttf</string>
        <string>Fonts/dm-mono-500.ttf</string>
    </array>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>com.birdiebuddy.mobile</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>birdiebuddy</string>
            </array>
        </dict>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
